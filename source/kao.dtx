% optional arg for custom mark
\NewDocumentCommand{\sidenotemark}{o}{%
	\@bsphack%
	\IfNoValueTF{#1}{%
		\stepcounter{sidenote}%
		\xdef\@thesnmark{\thesidenote}%
	}{%
		\xdef\@thesnmark{#1}%
	}%
	{\usekomafont{sidenotemark}\sidenotemarkformat{\@thesnmark}}%
	\@esphack%
}

\newcommand*\sidenotemarkformat[1]{\textsuperscript{#1}}
\newcommand*\sidenotelabelformat[1]{#1:\enskip}
% Allow to use \setkomafont{sidenotelabel} or \setkomafont{sidenote}
\newcommand*\scr@fnt@sidenotemark{\normalfont}
\newcommand*\scr@fnt@sidenotelabel{\normalfont}
