%% Modifies every float environment so that captions are placed in the margin.
%% It respects \captionabove, \captionof, and \captionaboveof (as well as the corresponding below's).
%% XXX: currently not compatible with the caption package. KOMAScript claims to be compatible, so we need to do something heh.
%% NOTE: calling \kaosidecaptionfalse makes it use almost the "regular" captions, either above or below. the difference is that the captions are as wide as the float (we need this for widefigure and widetable environments).
%% NOTE: calling \kaominipagefalse is the escape hatch: floats will be the regular LaTeX floats, instead of the redefined ones.
%% Our redefinition places the captions either above or below depending on the configuration, regardless of where the user writes the caption.
\setcapindent{0pt}
\renewcommand*{\captionformat}{:\enskip} % this is only what follows the label; the label itself is handled by \figureformat, \tableformat, and so on, which in turn uses \thefigure, \thetable, and so on.
\setkomafont{captionlabel}{\bfseries}

\newif\ifkaofloat\kaofloattrue
\let\latex@float\@float
\let\endlatex@float\end@float
\RenewDocumentEnvironment{@float}{m o O{t}}{%
	\ifkaofloat%
		\IfNoValueTF{#2}{%
			\edef\reserved@a{\noexpand\kaofloat{#1}[\csname fps@#1\endcsname][#3]}\reserved@a%
		}{%
			\kaofloat{#1}[#2][#3]%
		}%
	\else%
		\IfNoValueTF{#2}{%
			\edef\reserved@a{\noexpand\latex@float{#1}[\csname fps@#1\endcsname][#3]}\reserved@a%
		}{%
			\latex@float{#1}[#2]
		}%
	\fi%
}{%
	\ifkaofloat%
		\endkaofloat%
	\else%
		\endlatex@float%
	\fi%
}

\NewDocumentEnvironment{kaofloat}{m o o}{%
	\latex@float{#1}[#2]%
	\begin{kaominipage}[#3]{\linewidth}%
}{%
	\end{kaominipage}%
	\endlatex@float%
}

\newif\ifkaominipage\kaominipagetrue
\let\latexminipage\minipage
\let\endlatexminipage\endminipage
\RenewDocumentEnvironment{minipage}{O{c} m}{%
	% Logic for nested minipages: they are all kaominipages until \caption is used; then they become plain latexminipages.
	% User can also use kaominipage, subminipage, or latexminipage directly.
	% Alignments:
	% - t: everything (including side captions) aligns with the bottom of the graphics (default)
	% - b: everything aligns with the bottom of the captions
	% - to align everything with the very top: put \hbox{} at the beginning of the subminipages
	% XXX: should we use begin/end or just the plain macros? https://tex.stackexchange.com/questions/14683/defining-environments-based-on-other-ones-whats-the-right-way
	\if@kaominipage% we are in a nested minipage environment
		\let\@caption\kao@orig@@caption%
		\ifkao@captionused% this may be useless: if the \caption is used after the nested minipage, the switch will always be false
			\begin{latexminipage}[#1]{#2}%
			\kaominipagefalse% from now on, use only regular latexminipages
			\@kaominipagefalse% close the correct one
		\else%
			\begin{kaominipage}[#1]{#2}%
		\fi%
	\else%
		\ifkaominipage%
			\begin{kaominipage}[#1]{#2}%
		\else%
			\begin{latexminipage}[#1]{#2}%
		\fi%
	\fi%
}{%
	\if@kaominipage%
		\end{kaominipage}%
		\ifkao@captionused%
			\global\kao@captionusedfalse%
		\fi%
	\else%
		\end{latexminipage}%
	\fi%
}

% \capstart puts a whatsit which creates the link anchor. the anchor takes some space, so we need to be careful about where we put the whatsit.
% There are many cases depending also on the position of the caption (above or below).
% Sometimes we need to put \par before \capstart to make sure that the whatsit is on a new line; other times we wrap the whatsit and the graphic in a \vbox or \vtop.
% At any rate, \capstart must be seen by TeX *before* \caption
%
% the \label also puts a whatsit; users write \label after caption, but we overwrite \@caption making it essentially empty, so the \label would end up at the same level as the graphic. therefore we still need to add a \par inside our \@caption, so that the label's whatsit is in a line on its own and doesn't take space from the graphics.
%
% Sometimes if the whatsit is on the same line of the figure it can make the line overflow, so the whatsit is moved to the beginning of the next line and then the rest of the line is empty. this creates an extra line's worth of space above the caption. In this case, one thing we can do is to add \par in a strategic place.

\newif\ifkaosidecaption\kaosidecaptiontrue
\newsavebox{\kao@minipage@box}
\newcounter{minipage}
\newif\ifkao@captionused
\newif\ifkao@captionabove
\newif\if@kaominipage
\NewDocumentEnvironment{kaominipage}{O{t} m}{%
	\let\kao@orig@@caption\@caption%
	\def\kao@minipage@alignment{#1}%
	\@kaominipagetrue%
	\kao@captionusedfalse%
	\kao@captionabovefalse%
	\setbox\kao@minipage@box=\vbox\bgroup%
	\noindent\latexminipage[#1]{#2}%
	\stepcounter{minipage}%
	\long\def\@caption##1[##2]##3{%
		\ifkao@captionused%
			\ClassError{kao}{Multiple captions in kaominipage or kaofloat.}{%
			kaominipages and kaofloats can have only one \noexpand\caption.\MessageBreak%
			Please set \noexpand\kaofloatfalse before this float}%
		\fi%
		\hyper@makecurrent##1%
		\global\advance\csname c@##1\endcsname\m@ne%
		\xdef\kao@caption@type{##1}%
		\protected@xdef\kao@caption@entry{##2}%
		\protected@xdef\kao@caption@content{##3}%
		\if@captionabove%
			\global\kao@captionabovetrue%
		\fi%
		\global\kao@captionusedtrue%
		\par% needed to put the \label's whatsit on the line after the figure, otherwise it takes horizontal space.
	}%
	\centering%
}{%
	\endlatexminipage%
	\egroup%
	\ifkao@captionused%
		\def\@captype{\kao@caption@type}%
		\ifkaosidecaption%
			\ifkao@captionabove%
				\edef\kao@ht{\the\ht\kao@minipage@box}%
				\noindent\latexminipage[#1]{#2}%
				\vbox{\capstart%
				\unvbox\the\kao@minipage@box}%
				\endlatexminipage%
				\fixednote[-\kao@ht][t]{\captionabove[\kao@caption@entry]{\kao@caption@content}}%
			\else%
				\noindent\latexminipage[#1]{#2}%
				\vbox{\capstart%
				\unvbox\the\kao@minipage@box}%
				\endlatexminipage%
				\fixednote[0sp][b]{\captionbelow[\kao@caption@entry]{\kao@caption@content}}%
			\fi%
		\else%
			\ifkao@captionabove%
				\noindent\latexminipage[#1]{#2}%
				\vbox{\capstart%
				\captionabove[\kao@caption@entry]{\kao@caption@content}}%
				\unvbox\the\kao@minipage@box%
				\endlatexminipage%
			\else%
				\noindent\latexminipage[#1]{#2}%
				\vbox{\capstart%
				\unvbox\the\kao@minipage@box}%
				\captionbelow[\kao@caption@entry]{\kao@caption@content}%
				\endlatexminipage%
			\fi%
		\fi
	\else%
		\unvbox\kao@minipage@box%
	\fi%
}

\newsavebox{\kao@subminipage@box}
\newif\ifkao@subcaptionused
\newif\ifkao@subcaptionabove
\newif\if@subminipage
\NewDocumentEnvironment{subminipage}{o m}{%
	% Make sure that subminipages can be called oudside of kaominipages as well
	\ifdefined\kao@orig@@caption%
		\let\@caption\kao@orig@@caption%
	\fi%
	\edef\kao@subminipage@alignment{%
		\IfValueTF{#1}{#1}{%
			\ifdefined\kao@minipage@alignment%
				\kao@minipage@alignment%
			\else%
				t%
			\fi%
		}%
	}%
	\@subminipagetrue%
	\kao@subcaptionusedfalse%
	\kao@subcaptionabovefalse%
	\setbox\kao@subminipage@box=\hbox\bgroup% this must be hbox, whereas in kaominipage it must be a vbox. don't ask me why.
	\latexminipage[\kao@subminipage@alignment]{#2}%
	\def\@captype{subminipage}% default value; use \captionof{sub...} to override (although it's better not to change it... this ensures that the entries will be ordered a b c d. otherwise you could have two a's and three b's.)
	\long\def\@caption##1[##2]##3{%
		\ifkao@subcaptionused%
			\ClassError{kao}{Multiple captions in subminipage.}{%
			subminipage can have only one \noexpand\caption}%
		\fi%
		\hyper@makecurrent{##1}%
		\global\advance\csname c@##1\endcsname\m@ne%
		\xdef\kao@subcaption@type{##1}%
		\protected@xdef\kao@subcaption@entry{##2}%
		\protected@xdef\kao@subcaption@content{##3}%
		\if@captionabove%
			\global\kao@subcaptionabovetrue%
		\fi%
		\global\kao@subcaptionusedtrue%
		\par% needed to put the \label's whatsit on the line after the figure, otherwise it takes horizontal space.
	}%
	\centering%
}{%
	\endlatexminipage%
	\egroup%
	\ifkao@subcaptionused%
		\def\@captype{\kao@subcaption@type}%
		\ifkao@subcaptionabove%
			\latexminipage[\kao@subminipage@alignment]{#2}%
			\vbox{\capstart%
			\captionabove[\kao@subcaption@entry]{\kao@subcaption@content}}%
			\unhbox\the\kao@subminipage@box%
			\endlatexminipage%
		\else%
			\latexminipage[\kao@subminipage@alignment]{#2}%
			\vbox{\capstart%
			\unhbox\the\kao@subminipage@box}%
			\captionbelow[\kao@subcaption@entry]{\kao@subcaption@content}%
			\endlatexminipage%
		\fi%
	\else%
		\unhbox\the\kao@subminipage@box%
	\fi%
}

\NewDocumentCommand{\makesubcounter}{m}{% marg: the name of the environment
	\newcounter{sub#1}[#1] % Careful: what if #1 counter doesn't exist?
