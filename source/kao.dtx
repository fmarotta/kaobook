% Front matter
\let\oldfrontmatter\frontmatter % Store the old command
\renewcommand{\frontmatter}{%
	\oldfrontmatter% First of all, call the old command
	\pagestyle{plain.kaoheadings}% Use a plain style for the header and the footer
	\pagelayout{default}% Use a wide page layout
