% \section{Margin stuff}
% Here we define and explain the macros for putting stuff in the margin.
% Let's begin with margin table of contents.

% \iffalse
\RequirePackage{scrlayer-scrpage}
\RequirePackage{scrlayer-notecolumn}
\RequirePackage{localtoc}

\NewDocumentCommand{\sidetoc}{}{%
	\marklocaltoc%
	\ifvmode%
		\vbox{\hbox{\raisebox{\baselineskip}{\makenote{\printlocaltoc\thelocaltoc}}}}%
		\vskip-\dimexpr\baselineskip+\parskip\relax%
	\else%
		\@bsphack%
		\raisebox{\baselineskip}{\makenote{\printlocaltoc\thelocaltoc}}%
		\@esphack%
	\fi%
}

%% If issued in vmode, align the note with the next paragraph
\NewDocumentCommand{\sidepar}{m}{%
	\@bsphack%
	\ifvmode%
		\vskip\the\parskip\vbox{}\makenote{#1}\vskip-\dimexpr\baselineskip+\parskip\relax%
	\else%
		\makenote{#1}%
	\fi%
	\@esphack%
}

\NewDocumentEnvironment{sidefigure}{b}{%
	\makenote*{%
		\vspace{1em}%
		\begin{latexminipage}{\marginparwidth}%
			\def\caption{%
				\if@figurecaptionabove\expandafter\captionabove%
				\else\expandafter\captionbelow\fi%
			}%
			\def\@captype{figure}%
			\usekomafont{notecolumn.marginpar}%
			#1%
		\end{latexminipage}%
	}%
}{}

