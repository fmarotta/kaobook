% star - offset - mark - text
\NewDocumentCommand{\sidenotetext}{s o o m}{%
	\@bsphack%
	\IfNoValueTF{#3}{%
	}{%
		\xdef\@thesnmark{#3}%
	}%
	\IfBooleanTF{#1}{%
		\def\sidenote@makenote{\makenote*}%
	}{%
		\IfNoValueTF{#2}{%
			\def\sidenote@makenote{\makenote}%
		}{%
			\def\sidenote@makenote{\fixednote[#2]}%
		}%
	}%
	\sidenote@makenote{{\usekomafont{sidenotelabel}\sidenotelabelformat{\@thesnmark}}\usekomafont{sidenote}#4}%
	\@esphack%
}

% offset - mark - text
\NewDocumentCommand{\sidenote}{o o m}{%
