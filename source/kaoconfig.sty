% Fonts
\RequirePackage{mathtools}% Improved maths, automatically loads amsmath and extends it (we could load amsmath instead); should be loaded before unicode-math

\RequirePackage[english]{babel} % if using babel; must be loaded before newpx. If you use polyglossia, see below. polyglossia must be loaded after fontspec, which is loaded by newpx.

% Three default setups (taken from the newpx package manual)

	% Set up 1: LuaLaTeX, T1 math fonts, mathalpha
	\RequirePackage[T1]{fontenc} % T1 is active encoding for use in math text
	% \RequirePackage[type1]{sourcesanspro}% used only by \mathsf, optional
	% amsthm in next line loads amsmath, then loads amsthm (not necessary since we load mathtools earlier)
	\RequirePackage[no-math,amsthm,helvratio=.93,theoremfont,trueslanted,largesc,p]{newpx}
	% Fontspec will be loaded so that Opentype text fonts may be loaded
	\linespread{1.07}
	\defaultfontfeatures{Scale=MatchLowercase}
	\RequirePackage{classico} % sans-serif font: URW classico
	\setmonofont{DejaVu Sans Mono}[Scale=.85]
	% either mathalpha or unicode-math, choose one
	\RequirePackage[cal=stixplain,scr=stixtwofancy,bb=px]{mathalpha} % Mathscr from STIX

