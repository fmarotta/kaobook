% \section{User Manual}
% \label{intro}
% This package provides aliases for cleveref-zref and zref-vario to support different styles of referencing.
%
% Here are references to this section:
% \begin{description}
% \item[kref] \kref{conclusion}
% \item[krefv] \krefv{conclusion}
% \item[kreft] \kreft{intro}
% \item[kreff] \kreff{intro}
% \end{description}
%
% \begin{figure}[h]
% \centering
% \includegraphics[width=.5\textwidth]{../../testfiles/La_Gioconda_Leonardo_Da_Vinci.jpg}
% \caption{Mona lisa.}
% \label{lisa}
% \end{figure}
%
% Same thing for figures:
% \begin{description}
% \item[kref] \kref{lisa}
% \item[krefv] \krefv{lisa}
% \item[kreft] \kreft{lisa}
% \item[kreff] \kreff{lisa}
% \end{description}
% 
% Extra features:
% \begin{description}
% \item[abbrev] \kref[abbrev]{lisa}
% \item[abbrev] \kref[abbrev]{intro}
% \item[no link] \kref*{intro}
% \item[range] \kref{intro,impl}
% \item[mixed] \kreff{intro,lisa,impl,conclusion}
% \item[just title] \kref[noname,ref=title]{intro}
% \item[plain zvref] \zvref[abbrev]{lisa}
% \end{description}
%
% \section{Implementation}
% \label{impl}
% \begin{macro}{dependencies}
%    \begin{macrocode}
\RequirePackage{zref-vario} % Loads varioref, which must be loaded before hyperref
% XXX: check whether it works with kaobook, which loads hyperref before we have a chance to load zref-vario. maybe we need to add \RequirePackage{zref-vario} before \documentclass in the manual.
\RequirePackage{zref-titleref} % similar to \nameref (which is part of hyperref), but integrates better with zref-clever
\RequirePackage[hyperindex=false]{hyperref}
\RequirePackage{zref-clever}
%    \end{macrocode}
% \end{macro}

% \begin{macro}{\kref}
%    \begin{macrocode}
\NewDocumentCommand{\kref}{s O{} m}{% name, number
	\IfBooleanTF{#1}{\zcref*}{\zcref}[#2]{#3}%
}
\NewDocumentCommand{\krefv}{s O{} m}{% name, number, page
	\IfBooleanTF{#1}{\zvref*}{\zvref}[cap=false,capfirst,#2]{#3}%
}
\NewDocumentCommand{\kreft}{s O{} m}{% name, title
	\IfBooleanTF{#1}{\zcref*}{\zcref}[#2]{#3} (\zcref[noname,ref=title]{#3})%
}
\NewDocumentCommand{\kreff}{s O{} m}{% name, title, page
	\IfBooleanTF{#1}{\zcref*}{\zcref}[#2]{#3} (\zcref[noname,ref=title]{#3}) \zvpageref[nocap]{#3}%
}
%    \end{macrocode}
% \end{macro}

% \begin{macro}{config}
%    \begin{macrocode}
\zvsetup{pageprop=abspage}
\zcsetup{
	hyperref=true,
	nameinlink=tsingle,
	cap=true,
}
% Remove parentheses around equation numbers
\zcRefTypeSetup{equation}{
	refbounds = {,,,},
}
\zcLanguageSetup{english}{
	lastsep={,~and\nobreakspace},  % Oxford comma
	tlastsep={,~and\nobreakspace}, % Oxford comma
	type = chapter,
		Name-sg-ab = Chap.,
		name-sg-ab = chap.,
		Name-pl-ab = Chaps.,
		name-pl-ab = chaps.,
	type = section,
		Name-sg-ab = Sec.,
		name-sg-ab = sec.,
	type = appendix,
		Name-sg-ab = App.,
		name-sg-ab = app.,
		Name-pl-ab = Apps.,
		name-pl-ab = apps.,
	type = table,
		Name-sg-ab = Tab.,
		name-sg-ab = tab.,
		Name-pl-ab = Tabs.,
		name-pl-ab = tabs.,
	type = assumption,
		Name-sg = Assumption,
		name-sg = assumption,
		Name-pl = Assumptions,
		name-pl = assumptions,
}
